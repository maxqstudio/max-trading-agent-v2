# ============================================================
# Max Trading Agent v2 — Environment Configuration
# Copy to .env and fill in your credentials. Never commit .env!
# ============================================================

# Local MT5 Zero-DLL Bridge authentication token (must match EA input)
BRIDGE_AUTH_TOKEN=mta2_dev_change_me_to_random_secret_32chars

# Optional LLM Reflection Provider (leave keys blank to use Deterministic Quant Reflector)
# Supported: deterministic | gemini | openai | anthropic | ollama
LLM_PROVIDER=deterministic
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemini-2.5-flash

# Optional Telegram Control Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server bind settings
API_HOST=127.0.0.1
API_PORT=8765
