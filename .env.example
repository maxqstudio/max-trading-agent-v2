# ============================================================
# Max Trading Agent v2 — Environment Configuration
# Copy to .env and fill in your credentials. Never commit .env!
# ============================================================

# Local MT5 Zero-DLL Bridge authentication token (must match EA input).
# Leave blank here: setup_and_test.bat generates a random one into .env.
BRIDGE_AUTH_TOKEN=

# Token the dashboard / API needs for anything that changes state (mode, risk, kill switch...).
# Leave blank here: setup_and_test.bat generates a random one into .env.
CONTROL_API_TOKEN=

# REAL-MONEY SWITCH. Keep false until you have run SHADOW_ONLY and MT5_DEMO for weeks.
# With false, the engine refuses every new entry on a real account, whatever mode is selected.
ALLOW_LIVE_TRADING=false

# ------------------------------------------------------------
# LLM providers (Claude first). Easiest: double-click llm_setup.bat
# ------------------------------------------------------------
# Order to try. First one that is configured and answers wins; the rest are fallbacks.
# Options: anthropic, gemini, openai, openrouter, groq, deepseek, mistral, xai, together,
#          ollama, llamacpp, custom.   Set to "off" for deterministic quant only.
LLM_PROVIDER_CHAIN=anthropic,gemini,openai

# Claude (recommended). MODEL = reflection, FAST_MODEL = scalping supervisor.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# Google Gemini (AI Studio key). Put the exact model id you use.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FAST_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_FAST_MODEL=

# Other hosted, OpenAI-compatible (fill only what you use):
# OPENROUTER_API_KEY=   OPENROUTER_MODEL=
# GROQ_API_KEY=         GROQ_MODEL=
# DEEPSEEK_API_KEY=     DEEPSEEK_MODEL=
# MISTRAL_API_KEY=      XAI_API_KEY=      TOGETHER_API_KEY=

# Local, free, no key:
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1      OLLAMA_MODEL=llama3.1
# LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1     LLAMACPP_MODEL=local
# Any other OpenAI-compatible server:
# CUSTOM_BASE_URL=   CUSTOM_MODEL=   CUSTOM_API_KEY=

# Optional Telegram Control Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server bind settings
API_HOST=127.0.0.1
API_PORT=8765
